{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm ci",
  "regions": ["iad1"],
  "functions": {
    "app/api/events/route.ts": {
      "maxDuration": 30
    },
    "app/api/assign/route.ts": {
      "maxDuration": 30
    },
    "app/api/complete/route.ts": {
      "maxDuration": 30
    },
    "app/api/admin/batches/[id]/reconcile/route.ts": {
      "maxDuration": 30
    },
    "app/api/prolific/webhook/route.ts": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
